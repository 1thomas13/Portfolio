---
import { DIARY_TZ } from "astro:env/server"
import Entry from "@/components/diary/Entry.astro"
import DiaryLayout from "@/layouts/DiaryLayout.astro"
import {
  CLOSE_QUESTIONS,
  TYPES,
  carriedWeeks,
  daysOf,
  formatDay,
  isWeekId,
  openWeek,
  shiftWeek,
  slug,
  tagsOf,
  today,
  weekOf,
  type Week,
} from "@/lib/diary/week"
import { read, update } from "@/lib/diary/store"

export const prerender = false

const now = today(DIARY_TZ)
const currentId = weekOf(now)
const previousId = shiftWeek(currentId, -1)
const param = Astro.url.searchParams.get("week") ?? ""
const id = isWeekId(param) && param <= currentId ? param : currentId
const isCurrent = id === currentId
const canClose = isCurrent || id === previousId

let error = ""
// If saving fails, what was written goes back into the form
let draft = { type: "", text: "", next: "" }

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  const field = (name: string) => String(form.get(name) ?? "").trim()
  const back = (hash = "", ok = "") => {
    const params = new URLSearchParams({ ...(isCurrent ? {} : { week: id }), ...(ok ? { ok } : {}) })
    return Astro.redirect(`/diary/${params.size ? `?${params}` : ""}${hash}`, 303)
  }
  const inCurrent = (change: (week: Week) => void) => ({ weeks }: { weeks: Map<string, Week> }) => {
    const changed = openWeek(weeks, currentId)
    const week = weeks.get(currentId)!
    change(week)
    return [...changed, week]
  }

  try {
    switch (field("action")) {
      case "entry": {
        const type = TYPES.find((t) => t.key === field("type")) ?? TYPES[0]
        const extraTags = [...form.getAll("tag").map(String), ...field("tags").split(/[\s,]+/)]
          .map((tag) => tag.replace(/^#/, "").toLowerCase())
          .filter(Boolean)
        const base = field("text")
        if (!base) throw new Error("Escribí algo antes de guardar.")
        const missing = [...new Set(extraTags)].filter((tag) => !tagsOf(base).includes(tag))
        const text = [base, ...missing.map((tag) => `#${tag}`)].join(" ")
        const date = daysOf(currentId).includes(field("day")) && field("day") <= now ? field("day") : now
        await update("Entry", inCurrent((week) => {
          let day = week.days.find((d) => d.date === date)
          if (!day) week.days.push((day = { date, entries: [] }))
          week.days.sort((a, b) => a.date.localeCompare(b.date))
          day.entries.push({ type: type.label.toLowerCase(), text, next: field("next") || undefined, star: form.has("star") })
        }))
        return back("#write", "entry")
      }
      case "pending": {
        const text = field("text")
        if (text) await update("Pending item", inCurrent((week) => week.pending.push({ text, state: " " })))
        return back("#pending", "pending")
      }
      case "toggle": {
        const index = Number(field("index"))
        await update("Pending item toggled", inCurrent((week) => {
          const item = week.pending[index]
          if (item && item.text === field("text")) item.state = item.state === "x" ? " " : "x"
        }))
        return back("#pending")
      }
      case "close": {
        if (!canClose) throw new Error("Solo se puede cerrar esta semana o la anterior.")
        await update(`Week ${id} close`, ({ weeks }) => {
          const changed = isCurrent ? openWeek(weeks, id) : []
          const week = weeks.get(id) ?? { id, pending: [], days: [], close: [], extra: [] }
          weeks.set(id, week)
          const others = week.close.filter((c) => !CLOSE_QUESTIONS.includes(c.question))
          week.close = [...CLOSE_QUESTIONS.map((question, i) => ({ question, answer: field(`close-${i}`) })), ...others]
          return [...changed, week]
        })
        return back("#close", "close")
      }
    }
  } catch (e) {
    error = e instanceof Error ? e.message : String(e)
    draft = { type: field("type"), text: field("text"), next: field("next") }
    Astro.response.status = 400
  }
}

let weeks = new Map<string, Week>()
try {
  weeks = (await read()).weeks
} catch (e) {
  error ||= e instanceof Error ? e.message : String(e)
}
// If the week doesn't exist yet, show it as it will be (with the carried-over pending items)
if (isCurrent) openWeek(weeks, id)
const week = weeks.get(id)
const days = [...(week?.days ?? [])].filter((d) => d.entries.length).reverse()
const entries = days.flatMap((d) => d.entries)
const counts = TYPES.map((t) => ({ ...t, count: entries.filter((e) => slug(e.type) === t.key).length })).filter((t) => t.count)
const starred = entries.filter((e) => e.star).length
const knownTags = Object.entries(
  [...weeks.values()]
    .flatMap((w) => [...w.pending.map((p) => p.text), ...w.days.flatMap((d) => d.entries.map((e) => e.text))].flatMap(tagsOf))
    .reduce<Record<string, number>>((acc, tag) => ({ ...acc, [tag]: (acc[tag] ?? 0) + 1 }), {}),
)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([tag]) => tag)
const close = CLOSE_QUESTIONS.map((question) => ({ question, answer: week?.close.find((c) => c.question === question)?.answer ?? "" }))
const otherClose = week?.close.filter((c) => !CLOSE_QUESTIONS.includes(c.question)) ?? []
const answered = close.filter((c) => c.answer).length
const weekday = new Date(`${now}T00:00:00Z`).getUTCDay()
const closeOpen = id === previousId || weekday === 0 || weekday === 1

const weekDays = daysOf(id)
const [year, number] = id.split("-W")
const range = `${formatDay(weekDays[0], { day: "numeric", month: "short" })} – ${formatDay(weekDays[6], { day: "numeric", month: "short" })}`
const dayOptions = daysOf(currentId)
  .filter((d) => d <= now)
  .reverse()
  .map((d, i) => ({ value: d, label: i === 0 ? "Hoy" : i === 1 ? "Ayer" : formatDay(d, { weekday: "long" }) }))
const selectedType = TYPES.find((t) => t.key === draft.type) ?? TYPES[0]
const OK = { entry: "Guardado", pending: "Pendiente sumado", close: "Cierre guardado" }
const ok = OK[Astro.url.searchParams.get("ok") as keyof typeof OK]

const input = "w-full border-2 border-fg bg-cream px-3 py-2.5 text-base placeholder:text-muted"
const chip =
  "relative inline-flex min-h-10 cursor-pointer items-center border-2 border-fg px-3 font-mono text-sm whitespace-nowrap uppercase has-checked:bg-fg has-checked:text-bg has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent-text"
const card = "border-2 border-fg p-4 md:p-6"
---

<DiaryLayout title={`Semana ${Number(number)}`}>
  <div class="flex items-center justify-between gap-4">
    <a href={`/diary/?week=${shiftWeek(id, -1)}`} aria-label="Semana anterior" class="-m-2 p-3 font-mono text-lg hover:text-accent-text">←</a>
    <div class="text-center">
      <h1 class="text-xl font-semibold md:text-2xl">{isCurrent ? "Esta semana" : `Semana ${Number(number)}`}</h1>
      <p class="font-mono text-xs text-muted uppercase">{isCurrent && `Semana ${Number(number)} · `}{range} {year}</p>
    </div>
    {
      isCurrent ? (
        <span class="w-10" aria-hidden="true" />
      ) : (
        <a href={id < previousId ? `/diary/?week=${shiftWeek(id, 1)}` : "/diary/"} aria-label="Semana siguiente" class="-m-2 p-3 font-mono text-lg hover:text-accent-text">
          →
        </a>
      )
    }
  </div>

  {
    (counts.length > 0 || !isCurrent) && (
      <p class="mt-3 flex flex-wrap justify-center gap-x-3 gap-y-1 font-mono text-xs text-muted">
        {starred > 0 && (
          <a href="/diary/search?starred=1" class="text-accent-text">
            ★ {starred}
          </a>
        )}
        {counts.map((t) => (
          <a href={`/diary/search?type=${t.key}`} class="hover:text-accent-text">
            {t.count} {t.label.toLowerCase()}
          </a>
        ))}
        {!isCurrent && (
          <a href="/diary/" class="text-accent-text">
            Volver a hoy
          </a>
        )}
      </p>
    )
  }

  {
    error && (
      <p role="alert" class="mt-6 border-2 border-accent-text p-4 font-mono text-sm text-accent-text">
        {error}
      </p>
    )
  }

  <div class="mt-6 grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
    <div class="contents lg:grid lg:gap-8">
      {
        isCurrent && (
          <section id="write" aria-label="Anotar" class:list={[card, "order-1 scroll-mt-20 lg:order-0"]}>
            <form method="post" class="grid gap-4" data-entry-form>
              <input type="hidden" name="action" value="entry" />
              <fieldset class="-mx-4 min-w-0 overflow-x-auto px-4 md:mx-0 md:px-0">
                <legend class="sr-only">Tipo</legend>
                <div class="flex gap-2">
                  {TYPES.map((type) => (
                    <label class={chip}>
                      <input type="radio" name="type" value={type.key} checked={type === selectedType} data-placeholder={type.placeholder} class="sr-only" />
                      {type.label}
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="grid gap-1.5">
                <label for="text" class="font-mono text-xs text-muted uppercase">
                  Qué pasó
                </label>
                <textarea id="text" name="text" rows="3" required placeholder={selectedType.placeholder} class={input}>{draft.text}</textarea>
              </div>

              <div class="grid gap-1.5">
                <label for="next" class="font-mono text-xs text-muted uppercase">
                  ¿Y ahora qué? · opcional
                </label>
                <textarea id="next" name="next" rows="2" placeholder="Qué hacés distinto, o dónde lo usarías." class={input}>{draft.next}</textarea>
              </div>

              <fieldset class="min-w-0">
                <legend class="mb-1.5 font-mono text-xs text-muted uppercase">Etiquetas</legend>
                <div class="flex flex-wrap gap-2">
                  {knownTags.map((tag) => (
                    <label class={chip}>
                      <input type="checkbox" name="tag" value={tag} class="sr-only" />#{tag}
                    </label>
                  ))}
                  <label for="tags" class="sr-only">
                    Otra etiqueta
                  </label>
                  <input
                    id="tags"
                    name="tags"
                    placeholder={knownTags.length ? "+ otra" : "#trabajo #personal"}
                    autocomplete="off"
                    autocapitalize="none"
                    class="min-h-10 w-32 grow border-2 border-dashed border-fg bg-cream px-3 font-mono text-base placeholder:text-muted sm:grow-0"
                  />
                </div>
              </fieldset>

              <div class="flex flex-wrap items-center gap-2">
                <label class={chip}>
                  <input type="checkbox" name="star" class="sr-only" />★ Importante
                </label>
                {dayOptions.length > 1 && (
                  <>
                    <label for="day" class="sr-only">
                      Día
                    </label>
                    <select id="day" name="day" class="min-h-10 border-2 border-fg bg-cream px-2 font-mono text-base uppercase">
                      {dayOptions.map((d) => (
                        <option value={d.value}>{d.label}</option>
                      ))}
                    </select>
                  </>
                )}
                <button class="btn ml-auto w-full justify-center bg-fg text-bg sm:w-auto">Guardar</button>
              </div>

              <details class="text-sm text-muted">
                <summary class="cursor-pointer font-mono text-xs uppercase">Cómo escribirlo</summary>
                <p class="mt-2 max-w-[52ch]">Qué pasó (concreto) → qué esperabas o creías → qué te llevás. Contalo como a alguien: la definición de algo ya está en Google.</p>
              </details>
            </form>
          </section>
        )
      }

      <section aria-labelledby="entries" class="order-3 lg:order-0">
        <h2 id="entries" class="label">Entradas</h2>
        {days.length === 0 && <p class="mt-3 text-muted">{isCurrent ? "Todavía nada esta semana." : "Esta semana no hay entradas."}</p>}
        {
          days.map((day) => (
            <div class="mt-4">
              <h3 class="border-b-2 border-fg pb-1 font-mono text-xs uppercase">{day.date === now ? "Hoy" : formatDay(day.date)}</h3>
              {day.entries.map((entry, index) => (
                <Entry entry={entry} at={{ week: id, date: day.date, index }} />
              ))}
            </div>
          ))
        }
      </section>
    </div>

    <div class="contents lg:grid lg:gap-8">
      <section id="pending" aria-labelledby="pending-title" class:list={[card, "order-2 scroll-mt-20 lg:order-0"]}>
        <h2 id="pending-title" class="label">Pendientes</h2>
        <ul class="mt-2">
          {
            week?.pending.map((item, index) => {
              const carried = item.state === " " ? carriedWeeks(weeks, id, item.text) : 1
              const done = item.state === "x"
              return (
                <li class="flex items-center gap-3 border-b border-fg/25 py-1.5 last:border-b-0">
                  {isCurrent ? (
                    <form method="post" class="shrink-0">
                      <input type="hidden" name="action" value="toggle" />
                      <input type="hidden" name="index" value={index} />
                      <input type="hidden" name="text" value={item.text} />
                      <button
                        role="checkbox"
                        aria-checked={done ? "true" : "false"}
                        aria-label={item.text}
                        class:list={["grid size-9 place-items-center border-2 border-fg font-mono", done && "bg-fg text-bg"]}
                      >
                        {done ? "✓" : ""}
                      </button>
                    </form>
                  ) : (
                    <span class="grid size-9 shrink-0 place-items-center font-mono text-muted" aria-hidden="true">
                      {item.state === ">" ? "→" : item.state === "x" ? "✓" : "·"}
                    </span>
                  )}
                  <span class:list={["grow py-1.5", done && "text-muted line-through", item.state === ">" && "text-muted"]}>
                    {item.text}
                    {item.state === ">" && <span class="font-mono text-xs uppercase"> · pasó</span>}
                    {carried > 1 && <span class="ml-1 font-mono text-xs whitespace-nowrap text-accent-text uppercase">· {carried}ª semana</span>}
                  </span>
                </li>
              )
            })
          }
        </ul>
        {!week?.pending.length && <p class="mt-2 text-muted">Sin pendientes.</p>}
        {
          isCurrent && (
            <form method="post" class="mt-3 flex gap-2">
              <input type="hidden" name="action" value="pending" />
              <label for="new-pending" class="sr-only">
                Nuevo pendiente
              </label>
              <input id="new-pending" name="text" required placeholder="Nuevo pendiente" autocomplete="off" class:list={[input, "min-w-0 flex-1"]} />
              <button class="btn shrink-0 px-4" aria-label="Sumar pendiente">
                +
              </button>
            </form>
          )
        }
      </section>

      <section id="close" class:list={[card, "order-4 scroll-mt-20 lg:order-0"]}>
        {
          canClose ? (
            <details open={closeOpen || undefined}>
              <summary class="flex cursor-pointer items-center justify-between gap-4">
                <h2 class="label">Cierre de la semana</h2>
                <span class="font-mono text-xs text-muted">{answered}/3</span>
              </summary>
              <form method="post" class="mt-4 grid gap-4">
                <input type="hidden" name="action" value="close" />
                {close.map((c, i) => (
                  <div class="grid gap-1.5">
                    <label for={`close-${i}`} class="font-semibold">
                      {c.question}
                    </label>
                    <textarea id={`close-${i}`} name={`close-${i}`} rows="3" class={input}>{c.answer}</textarea>
                  </div>
                ))}
                <button class="btn justify-center">Guardar cierre</button>
              </form>
            </details>
          ) : (
            <>
              <h2 class="label">Cierre de la semana</h2>
              <dl class="mt-3 grid gap-4">
                {[...close, ...otherClose]
                  .filter((c) => c.answer)
                  .map((c) => (
                    <div>
                      <dt class="font-semibold">{c.question}</dt>
                      <dd class="mt-1 leading-relaxed whitespace-pre-line text-muted">{c.answer}</dd>
                    </div>
                  ))}
              </dl>
              {!week?.close.some((c) => c.answer) && <p class="mt-2 text-muted">Sin cierre.</p>}
            </>
          )
        }
      </section>

      {
        week?.extra.map((section) => (
          <section class:list={[card, "order-5 lg:order-0"]}>
            <h2 class="label">{section.heading}</h2>
            <p class="mt-3 leading-relaxed whitespace-pre-line">{section.body.trim()}</p>
          </section>
        ))
      }

      <a href={`/diary/edit?week=${id}`} class="order-6 font-mono text-xs text-muted uppercase hover:text-accent-text lg:order-0">Editar la semana a mano →</a>
    </div>
  </div>

  {
    ok && (
      <p role="status" data-toast class="fixed inset-x-4 bottom-20 z-50 mx-auto w-fit border-2 border-fg bg-fg px-4 py-2 font-mono text-sm text-bg uppercase transition-opacity duration-500 md:bottom-6">
        ✓ {ok}
      </p>
    )
  }
</DiaryLayout>

<script>
  const toast = document.querySelector<HTMLElement>("[data-toast]")
  if (toast) {
    // Without ?ok, reloading the page doesn't show the toast again
    const url = new URL(location.href)
    url.searchParams.delete("ok")
    history.replaceState(null, "", url)
    setTimeout(() => (toast.style.opacity = "0"), 1800)
  }

  const form = document.querySelector<HTMLFormElement>("[data-entry-form]")
  form?.addEventListener("change", (event) => {
    const radio = event.target as HTMLInputElement
    if (radio.name === "type") form.querySelector<HTMLTextAreaElement>("#text")!.placeholder = radio.dataset.placeholder ?? ""
  })
</script>
