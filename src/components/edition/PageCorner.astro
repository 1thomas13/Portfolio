---
// Folded corner that turns the page (data-turn="corner", see transition.css). The destination page
// peeks underneath, in its background color
interface Props {
  href: string
  label: string
  under?: string
  underText?: string
}
const { href, label, under = "var(--sand)", underText = "var(--ink)" } = Astro.props

// Slightly curved edges, like paper that doesn't lie completely flat
const flap = "M0,100 L100,0 C70,2 30,3 3,3 C3,30 2,70 0,100 Z"
---

<a href={href} class="page-corner" data-turn="corner" aria-label={label} style={`--under:${under};--under-text:${underText}`}>
  <span class="page-corner-under" aria-hidden="true"><span>{label} →</span></span>
  <svg class="page-corner-flap" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="page-corner-cast" x1="0.5" y1="0.5" x2="1" y2="1">
        <stop offset="0" stop-color="#000" stop-opacity="0.45" />
        <stop offset="0.22" stop-color="#000" stop-opacity="0.16" />
        <stop offset="0.55" stop-color="#000" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="page-corner-back" x1="0" y1="0" x2="0.5" y2="0.5">
        <stop offset="0" class="page-corner-tip" />
        <stop offset="0.55" class="page-corner-shine" />
        <stop offset="0.86" class="page-corner-tip" />
        <stop offset="1" class="page-corner-crease" />
      </linearGradient>
      <filter id="page-corner-blur" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="2.5" />
      </filter>
      <!-- Without this the shadow bleeds into the margin outside the frame -->
      <clipPath id="page-corner-clip"><rect width="100" height="100" /></clipPath>
    </defs>
    <polygon points="100,0 100,100 0,100" fill="url(#page-corner-cast)" />
    <g clip-path="url(#page-corner-clip)">
      <path class="page-corner-shadow" d={flap} transform="translate(3 3)" filter="url(#page-corner-blur)" />
    </g>
    <path d={flap} fill="url(#page-corner-back)" />
  </svg>
  <span class="page-corner-grain" aria-hidden="true"></span>
</a>

<style>
  .page-corner {
    --c: 52px;
    position: fixed;
    right: 6px;
    bottom: 6px;
    z-index: 96;
    width: var(--c);
    height: var(--c);
    transition: width 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), height 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .page-corner:hover,
  .page-corner:focus-visible {
    --c: 128px;
  }

  @media (min-width: 768px) {
    .page-corner {
      --c: 64px;
      right: 10px;
      bottom: 10px;
    }

    .page-corner:hover,
    .page-corner:focus-visible {
      --c: 150px;
    }
  }

  .page-corner-under {
    position: absolute;
    inset: 0;
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
    background: var(--under);
    color: var(--under-text);
  }

  .page-corner-under span {
    position: absolute;
    left: 67%;
    top: 67%;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translate(-50%, -50%) rotate(-45deg);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .page-corner:hover .page-corner-under span,
  .page-corner:focus-visible .page-corner-under span {
    opacity: 1;
    transition-delay: 0.15s;
  }

  .page-corner-flap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .page-corner-shadow {
    fill: rgb(0 0 0 / 0.3);
  }

  .page-corner-tip {
    stop-color: color-mix(in srgb, var(--bg) 92%, var(--fg));
  }

  .page-corner-shine {
    stop-color: color-mix(in srgb, var(--bg) 94%, white);
  }

  .page-corner-crease {
    stop-color: color-mix(in srgb, var(--bg) 76%, var(--fg));
  }

  /* The corner sits above the site's grain (body::after), so it carries its own */
  .page-corner-grain {
    position: absolute;
    inset: 0;
    clip-path: polygon(3% 3%, 100% 0, 100% 100%, 0 100%);
    pointer-events: none;
    opacity: 0.42;
    mix-blend-mode: multiply;
    background-image: var(--grain);
  }

  @media (prefers-reduced-motion: reduce) {
    .page-corner {
      transition: none;
    }
  }
</style>
