---
import { formatDate, getI18N, getLocale } from "@/i18n"

const currentLocale = getLocale(Astro.url)
const t = getI18N({ currentLocale })

const [issue, place] = t.edition.masthead
// Computed at build time; the script updates it with the visitor's date
const now = new Date()
const month = new Intl.DateTimeFormat(currentLocale, { month: "long" }).format(now)
const date = `${month} ${now.getFullYear()}`

const contents = [
  { n: "01", title: t.what.label.split("—")[1].trim(), href: "#que-hago" },
  ...t.projectsData.map((project, i) => ({ n: "02", title: project.title, tag: `${t.edition.article} 0${i + 1}`, href: "#proyectos" })),
  { n: "03", title: t.experience.title, href: "#experiencia" },
  { n: "04", title: t.contact.title, href: "#contacto" },
]
---

<section id="top" data-theme-section="sand" class="container-x relative flex min-h-[calc(100svh-54px)] flex-col pt-[3svh] pb-[3svh] md:min-h-[calc(100svh-62px)]">
  <div data-masthead class="mb-[4svh] flex flex-wrap justify-between gap-x-6 gap-y-1 border-y-2 border-fg py-2 font-mono text-[11px] tracking-[0.08em] uppercase select-none md:text-xs">
    <a href={currentLocale === "en" ? "/en/versions" : "/versiones"} class="underline-offset-4 hover:text-accent-text hover:underline">{issue} · {t.edition.pastEditions} →</a>
    <span data-masthead-date>{date}</span>
    <span class="hidden md:inline">{place}</span>
  </div>

  <div class="my-auto">
  <div class="flex items-end justify-between gap-12">
    <h1 data-reveal class="display flex flex-col items-start">
      <span class="text-[clamp(22px,min(3.4vw,5.6svh),52px)]">{t.hero.name}</span>
      <span data-big class="mt-[1svh] text-[clamp(64px,min(35vw,15svh),160px)] md:text-[clamp(96px,min(16.5vw,27svh),250px)]">{t.hero.title}</span>
      <span class="mt-[1.2svh] text-[clamp(22px,min(3.4vw,5.6svh),52px)]">
        {t.hero.titleLead} <span class="text-accent">{t.hero.titleAccent}</span>
      </span>
    </h1>

    <nav aria-label={t.edition.contents} class="hidden w-[19rem] shrink-0 lg:block">
      <h2 class="label border-b-2 border-fg pb-2">{t.edition.contents}</h2>
      <ol>
        {
          contents.map((item) => (
            <li>
              <a href={item.href} data-scroll-to={item.href} class="group flex items-baseline gap-3 border-b border-fg/25 py-2 text-[15px] transition-colors hover:text-accent-text">
                <span class="font-mono text-xs text-muted group-hover:text-accent-text">{item.n}</span>
                <span class="truncate">{item.title}</span>
                <span class="mb-1 min-w-4 flex-1 border-b border-dotted border-fg/40" />
                <span class="font-mono text-[11px] text-muted uppercase group-hover:text-accent-text">{item.tag ?? "→"}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <div class="mt-[4.5svh] flex flex-col gap-[3svh]">
    <p class="max-w-[44ch] text-[15px] leading-relaxed text-muted md:text-lg">{t.hero.sub}</p>
    <div class="flex shrink-0 flex-wrap gap-3">
      <a href="#contacto" data-scroll-to="#contacto" class="btn bg-fg text-bg hover:border-accent hover:bg-accent hover:text-cream">{t.hero.talk} →</a>
      <div class="flex flex-col gap-1.5">
        <a href={t.meta.cv} target="_blank" rel="noopener noreferrer" class="btn">{t.hero.cv}</a>
        <span class="font-mono text-[11px] text-muted">{t.meta.cvUpdatedLabel} {formatDate(t.meta.cvUpdated, currentLocale)}</span>
      </div>
    </div>
  </div>
  </div>

</section>

<script>
  const date = document.querySelector<HTMLElement>("[data-masthead-date]")
  if (date) {
    const now = new Date()
    date.textContent = `${new Intl.DateTimeFormat(document.documentElement.lang, { month: "long" }).format(now)} ${now.getFullYear()}`
  }

  // Hidden entrance to the diary: 5 quick taps on the masthead (outside the link), or typing
  // "diary" on the keyboard
  let taps = 0
  let reset: ReturnType<typeof setTimeout>
  document.querySelector("[data-masthead]")?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) return
    clearTimeout(reset)
    reset = setTimeout(() => (taps = 0), 1500)
    if (++taps >= 5) location.href = "/diary/"
  })
  let typed = ""
  document.addEventListener("keydown", (event) => {
    if (event.key.length !== 1 || (event.target as HTMLElement).closest?.("input, textarea, [contenteditable]")) return
    typed = (typed + event.key.toLowerCase()).slice(-5)
    if (typed === "diary") location.href = "/diary/"
  })
</script>
