---
import { getI18N, getLocale } from "@/i18n"
import Colophon from "../edition/Colophon.astro"

const currentLocale = getLocale(Astro.url)
const t = getI18N({ currentLocale })

const email = t.contactData.email.value
const links = [
  { label: "LinkedIn", href: t.contactData.linkedin.href },
  { label: "GitHub", href: t.contactData.github.href },
  { label: t.contact.cv, href: t.meta.cv },
]
---

<section id="contacto" data-theme-section="ink" class="container-x flex flex-col pt-16 pb-8 md:min-h-[calc(100svh-62px)] md:pt-[5svh] md:pb-[3svh]">
  <p class="label border-t-2 border-fg pt-4">{t.contact.label}</p>

  <div class="mt-8 grid gap-14 md:mt-[4svh] md:grid-cols-[1fr_1fr] md:gap-16">
    <div class="flex flex-col gap-8 md:gap-[4svh]">
      <h2 data-reveal class="display text-[clamp(96px,min(14vw,24svh),210px)]">
        {t.contact.title}<span class="text-accent">.</span>
      </h2>

      <div>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={`mailto:${email}`} class="border-b-2 border-accent text-[clamp(22px,2.4vw,32px)] font-semibold tracking-[-0.03em]">{email}</a>
          <button
            type="button"
            data-copy={email}
            data-copied={t.contact.copied}
            class="cursor-pointer border-2 border-fg px-3.5 py-1.5 font-mono text-xs uppercase text-fg transition-colors hover:bg-fg hover:text-bg">
            {t.contact.copy}
          </button>
        </div>
        <ul class="mt-5 flex gap-7 text-lg">
          {
            links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="hover:text-accent-text">
                  {link.label} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <Colophon part="note" />
    </div>

    <Colophon part="editions" />
  </div>

  <footer class="mt-auto flex flex-col justify-between gap-3 pt-16 font-mono md:pt-[4svh] text-[13px] text-muted md:flex-row">
    <span>© <span data-current-year>{new Date().getFullYear()}</span> Thomas Barreto · {t.footer.rights}</span>
    <a href="https://github.com/1thomas13/Portfolio" target="_blank" rel="noopener noreferrer" class="hover:text-fg hover:underline">
      {t.footer.source} ↗
    </a>
  </footer>
</section>

<script>
  document.querySelectorAll("[data-current-year]").forEach((el) => (el.textContent = String(new Date().getFullYear())))

  // Without clipboard permission, select the text so it can be copied by hand
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    const label = button.textContent?.trim() ?? ""
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "")
        button.textContent = button.dataset.copied ?? label
        setTimeout(() => (button.textContent = label), 1800)
      } catch {
        const range = document.createRange()
        range.selectNodeContents(button.previousElementSibling as Node)
        getSelection()?.removeAllRanges()
        getSelection()?.addRange(range)
      }
    })
  })
</script>
