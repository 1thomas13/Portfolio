---
import Analytics from "@vercel/analytics/astro"
import "../styles/global.css"
import { getI18N, LOCALIZED_PATHS as PAIRS } from "@/i18n"

const currentLocale = Astro.url.pathname.startsWith("/en/") ? "en" : "es"
const t = getI18N({ currentLocale })
const lang = currentLocale === "en" ? "en" : "es"
interface Props {
  title?: string
  description?: string
  noindex?: boolean
  // Variants: the only themes the page may switch to while scrolling. Sections with any other
  // theme stay on paper (without themes, every section uses its own)
  themes?: ("sand" | "red" | "ink")[]
}

const { title = t.meta.title, description = t.meta.description, themes } = Astro.props
const noindex = Astro.props.noindex || !!themes

const path = Astro.url.pathname.replace(/(.)\/$/, "$1")
const esPath = Object.keys(PAIRS).find((es) => es === path || PAIRS[es].replace(/\/$/, "") === path)
const canonical = t.meta.siteUrl + (esPath ? (esPath === path ? esPath : PAIRS[esPath]) : path)

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Thomas Barreto",
  url: t.meta.siteUrl,
  jobTitle: "Full-stack developer",
  address: { "@type": "PostalAddress", addressLocality: "Río Grande", addressRegion: "Tierra del Fuego", addressCountry: "AR" },
  sameAs: [t.contactData.github.href, t.contactData.linkedin.href],
}
---

<!doctype html>
<html lang={lang} data-theme="sand" data-themes={themes?.join(" ")}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1e9da" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/unique/Unique-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/iosevka/Iosevka-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Page transition, shared with the old editions (the opt-in is inlined here because if it
         only comes in the stylesheet, the first visit to a page doesn't animate) -->
    <style is:inline>@view-transition{navigation:auto}</style>
    <link rel="stylesheet" href="/versions/transition.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Thomas Barreto" />
    {
      esPath && (
        <>
          <link rel="alternate" hreflang="es" href={`${t.meta.siteUrl}${esPath}`} />
          <link rel="alternate" hreflang="en" href={`${t.meta.siteUrl}${PAIRS[esPath]}`} />
          <link rel="alternate" hreflang="x-default" href={`${t.meta.siteUrl}${esPath}`} />
        </>
      )
    }
    <!-- Browser language: the first time someone opens the Spanish version without Spanish among
         their languages, they're sent to the English one. A choice made with ES / EN is respected
         (tb-lang). Search engines and Lighthouse aren't redirected -->
    <script is:inline>
      ;(function () {
        try {
          var pairs = { "/": "/en/", "/versiones": "/en/versions" }
          var target = pairs[location.pathname.replace(/(.)\/$/, "$1")]
          if (!target || localStorage.getItem("tb-lang")) return
          if (/bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent)) return
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ""]
          if (!langs.some(function (l) { return /^es/i.test(l) })) location.replace(target + location.search + location.hash)
        } catch (e) {}
      })()
      // Remember a manually picked language, and let a data-turn link tell the next page how to
      // turn
      document.addEventListener("click", function (event) {
        var link = event.target.closest && event.target.closest("[data-lang-pick], [data-turn]")
        if (!link) return
        try {
          if (link.hasAttribute("data-lang-pick")) localStorage.setItem("tb-lang", link.getAttribute("data-lang-pick"))
          if (link.hasAttribute("data-turn")) sessionStorage.setItem("tb-turn", link.getAttribute("data-turn"))
        } catch (e) {}
      })
      // On the new page: if it was reached through the corner, use the "corner" transition
      window.addEventListener("pagereveal", function (event) {
        try {
          var turn = sessionStorage.getItem("tb-turn")
          sessionStorage.removeItem("tb-turn")
          if (turn && event.viewTransition && event.viewTransition.types) event.viewTransition.types.add(turn)
        } catch (e) {}
      })
    </script>
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_AR"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "es_AR" : "en_US"} />
    <meta property="og:site_name" content="Thomas Barreto Portfolio" />
    <meta property="og:image" content={`${t.meta.siteUrl}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${t.meta.siteUrl}/og.png`} />

    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <Analytics />
  </head>

  <body class="min-h-screen">
    <slot />
    <div class="page-frame" aria-hidden="true"></div>
    <script>
      import { initMotion } from "@/scripts/motion"
      import { fillYearsOnPage } from "@/scripts/years"
      initMotion()
      fillYearsOnPage()
    </script>
  </body>
</html>
